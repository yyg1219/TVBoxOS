<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 风格: 次要按钮, 常态安静深灰面板, 聚焦白描边(与主 CTA 蓝色实心形成层级) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_20" />
            <solid android:color="@color/tv_surface_elevated" />
            <stroke android:width="1.2mm" android:color="@color/tv_stroke_focused" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/vs_20" />
            <solid android:color="@color/tv_surface" />
            <stroke android:width="0.6dp" android:color="@color/tv_stroke" />
        </shape>
    </item>
</selector>
