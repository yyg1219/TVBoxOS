<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 风格: 聚焦 = 白色细描边(不再整块填充), 常态 = 低调深色面板 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10mm" />
            <stroke android:width="1.6mm" android:color="@color/tv_stroke_focused" />
            <solid android:color="@color/tv_accent_dim" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="10mm" />
            <solid android:color="@color/tv_surface_elevated" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="10mm" />
            <solid android:color="@color/color_6632364E" />
        </shape>
    </item>
</selector>
