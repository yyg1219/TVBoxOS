<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 风格: 分类排序胶囊 (高度 vs_45, 全圆角), 聚焦 = 白色描边高亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="22mm"/>
            <solid android:color="@color/tv_accent_dim"/>
            <stroke android:width="1.2mm" android:color="@color/tv_stroke_focused"/>
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="22mm"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</selector>
