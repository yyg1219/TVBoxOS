<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 风格: Hero 头部。海报保持原始比例贴右侧, 向左渐隐入深色, 大标题落在左侧。
     通过 adapter addHeaderView 插入列表顶部, 随内容滚动 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flHero"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_300"
    android:layout_marginLeft="@dimen/vs_60"
    android:layout_marginRight="@dimen/vs_60"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_tv_hero_bg">

    <ImageView
        android:id="@+id/ivHeroBack"
        android:layout_width="@dimen/vs_210"
        android:layout_height="@dimen/vs_285"
        android:layout_gravity="end|center_vertical"
        android:layout_marginRight="@dimen/vs_8"
        android:scaleType="fitCenter" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_25"
        android:paddingRight="@dimen/vs_210">

        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="2"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/ts_36"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeroNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_3"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/tv_text_secondary"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</FrameLayout>
